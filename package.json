{
  "name": "book-id-search",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "weread:review:auto-accept-isbn": "tsx scripts/weread/auto-accept-match-review.ts --review private-data/weread/derived/latest/weread-match-review.json --summary private-data/weread/derived/latest/weread-auto-accept-isbn-summary.json",
    "weread:review:auto-accept-title-author": "tsx scripts/weread/auto-accept-title-author-review.ts --review private-data/weread/derived/latest/weread-match-review.json --summary private-data/weread/derived/latest/weread-auto-accept-title-author-summary.json",
    "weread:review:build": "tsx scripts/weread/build-match-review.ts --matches private-data/weread/derived/latest/weread-matches.generated.json --out private-data/weread/derived/latest/weread-match-review.json --summary private-data/weread/derived/latest/weread-match-review-summary.json",
    "weread:review:apply": "tsx scripts/weread/apply-match-review.ts --review private-data/weread/derived/latest/weread-match-review.json --out private-data/weread/derived/latest/weread-matches.confirmed.json --summary private-data/weread/derived/latest/weread-match-confirmation-summary.json",
    "weread:confirmed:audit": "tsx scripts/weread/audit-confirmed-matches.ts --confirmed private-data/weread/derived/latest/weread-matches.confirmed.json --review private-data/weread/derived/latest/weread-match-review.json --out private-data/weread/derived/latest/weread-confirmed-audit.json --summary private-data/weread/derived/latest/weread-confirmed-audit-summary.json",
    "weread:duplicate:review": "tsx scripts/weread/build-duplicate-catalog-review.ts --confirmed private-data/weread/derived/latest/weread-matches.confirmed.json --review private-data/weread/derived/latest/weread-match-review.json --out private-data/weread/derived/latest/weread-duplicate-catalog-review.json --summary private-data/weread/derived/latest/weread-duplicate-catalog-review-summary.json",
    "weread:review:repair-invalid": "tsx scripts/weread/repair-confirmed-match-review.ts --review private-data/weread/derived/latest/weread-match-review.json --summary private-data/weread/derived/latest/weread-repair-invalid-confirmed-summary.json",
    "weread:review:summary": "tsx scripts/weread/summarize-match-review.ts --review private-data/weread/derived/latest/weread-match-review.json --confirmed private-data/weread/derived/latest/weread-matches.confirmed.json",
    "dev": "pnpm --parallel --filter @book-id-search/api --filter @book-id-search/web dev",
    "build": "pnpm --filter @book-id-search/api build && pnpm --filter @book-id-search/web build && tsc -p tsconfig.scripts.json --noEmit",
    "test": "vitest run",
    "health:check": "tsx scripts/production-health-check.ts",
    "ai:probe": "tsx scripts/ai-probe.ts",
    "verify": "tsx scripts/verify.ts",
    "import:sample": "tsx scripts/import-books.ts --file data/sample-books.txt --reset-index --report reports/latest-import-report.json",
    "import:file": "tsx scripts/import-books.ts",
    "audit:parse": "tsx scripts/audit-parse-quality.ts",
    "preflight:import": "tsx scripts/preflight-import.ts",
    "check:storage": "tsx scripts/check-storage-targets.ts",
    "benchmark:import": "tsx scripts/benchmark-import-configs.ts",
    "verify:deploy-package": "tsx scripts/verify-deploy-package.ts",
    "ai:quality": "tsx scripts/ai-quality-regression.ts",
    "search:quality": "tsx scripts/search-quality-regression.ts",
    "weread:validate": "tsx scripts/weread/validate-weread-snapshot.ts --dir samples/weread",
    "weread:match": "tsx scripts/weread/match-weread-catalog.ts",
    "weread:inspect": "tsx scripts/weread/inspect-weread-raw.ts --dir private-data/weread/raw/latest --out-json private-data/weread/audit/raw-inventory.latest.json --out-md private-data/weread/audit/raw-inventory.latest.md",
    "weread:normalize": "tsx scripts/weread/normalize-weread-export.ts --raw-dir private-data/weread/raw/latest --out-dir private-data/weread/snapshots/latest",
    "s32:schema:static": "vitest run scripts/s32-schema-contract.test.ts",
    "s32:schema:check": "tsx scripts/s32-schema-check.ts",
    "s32:m1a:check": "tsx scripts/s32-m1a-integration-check.ts",
    "s32:m1b:check": "tsx scripts/s32-m1b-integration-check.ts",
    "s32:m1c:check": "tsx scripts/s32-m1c-integration-check.ts",
    "s32:m1d:check": "tsx scripts/s32-m1d-integration-check.ts",
    "s32:m1e:check": "tsx scripts/s32-m1e-integration-check.ts",
    "s32:m2a:check": "tsx scripts/s32-m2a-integration-check.ts",
    "s32:m2b:check": "tsx scripts/s32-m2b-integration-check.ts",
    "s32:m2c:check": "tsx scripts/s32-m2c-integration-check.ts",
    "s32:m2d:check": "tsx scripts/s32-m2d-integration-check.ts"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "meilisearch": "^0.52.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.10.1",
    "jsdom": "^26.1.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.14"
  }
}
